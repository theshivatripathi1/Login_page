# Application Configuration
APP_NAME="AuthFlow"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"
FRONTEND_URL="http://localhost:5500"

# Database Configuration
DATABASE_URL="sqlite:///./authflow.db"

# Security & JWT Secrets
# Run: python -c "import secrets; print(secrets.token_hex(32))" to generate secure keys
SECRET_KEY="replace_with_a_secure_random_64_character_hex_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=10
OTP_EXPIRE_MINUTES=5

# Gmail SMTP Configuration
# Note: Generate an App Password from your Google Account (Security -> 2-Step Verification -> App Passwords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_FROM_NAME="AuthFlow Security"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=20
